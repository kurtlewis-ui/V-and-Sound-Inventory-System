// Vape Shop Management System
// Prisma Schema (Philippines, PHP currency, simplified per spec)
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  permissions Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  users User[]

  @@map("roles")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  firstName           String    @map("first_name") @db.VarChar(100)
  lastName            String    @map("last_name") @db.VarChar(100)
  roleId              String    @map("role_id") @db.Uuid
  // Branch a Staff is assigned to. Null for Owner/Admin who can act
  // across all branches; required (in business logic) for Staff.
  branchId            String?   @map("branch_id") @db.Uuid
  phone               String?   @db.VarChar(20)
  isActive            Boolean   @default(true) @map("is_active")
  isLocked            Boolean   @default(false) @map("is_locked")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamp(6)
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamp(6)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)

  // Optional middle initial (frontend collects an "M.I." field).
  middleInitial       String?   @map("middle_initial") @db.VarChar(5)
  avatarUrl           String?   @map("avatar_url") @db.Text

  // Relations
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions     Session[]
  auditLogs    AuditLog[]
  salesCreated Sale[]     @relation("SaleStaff")
  salesDecided Sale[]     @relation("SaleDecidedBy")
  disposals        Disposal[] @relation("DisposalCreatedBy")
  disposalsDecided Disposal[] @relation("DisposalDecidedBy")
  draftOrder   DraftOrder?
  expensesCreated Expense[] @relation("ExpenseStaff")
  expensesDecided Expense[] @relation("ExpenseDecidedBy")
  stockMovements  StockMovement[]

  @@index([roleId])
  @@index([branchId])
  @@index([email, passwordHash])
  @@index([isActive])
  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  tokenVersion     Int      @default(1) @map("token_version")
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  lastActivityAt   DateTime @default(now()) @map("last_activity_at") @db.Timestamp(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamp(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// BRANCHES
// ============================================================================

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  address   String?   @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  // Relations
  users          User[]
  inventory      Inventory[]
  sales          Sale[]
  disposals      Disposal[]
  draftOrders    DraftOrder[]
  expenses       Expense[]
  stockMovements StockMovement[]

  @@index([isActive])
  @@map("branches")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  requestId  String?  @map("request_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}


// ============================================================================
// CATALOG: BRANDS & PRODUCTS
// ============================================================================

model Brand {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  slug       String    @db.VarChar(120)
  coverImage String?   @map("cover_image") @db.Text
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamp(6)

  // Relations
  products Product[]

  @@index([deletedAt])
  @@index([slug])
  @@map("brands")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(150)
  slug          String    @db.VarChar(170)
  image         String?   @db.Text
  brandId       String    @map("brand_id") @db.Uuid
  // Selling price in PHP.
  sellingPrice  Decimal   @default(0) @map("selling_price") @db.Decimal(10, 2)
  // Cost/buying price in PHP (confidential — only visible to Owner role).
  costPrice     Decimal   @default(0) @map("cost_price") @db.Decimal(10, 2)
  // Low-stock threshold; 0 = no alert.
  quantityAlert Int       @default(0) @map("quantity_alert")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(6)

  // Relations
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  inventory      Inventory[]
  saleItems      SaleItem[]
  disposals      Disposal[]
  stockMovements StockMovement[]

  @@index([brandId])
  @@index([deletedAt])
  @@map("products")
}

// Per-branch stock level for a product.
model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("inventory")
}

// ============================================================================
// STOCK MOVEMENTS (history of every stock change per product per branch)
// ============================================================================

enum StockMovementType {
  SALE        // Stock decreased by a sale being approved
  RESTOCK     // Stock increased by admin restock
  DISPOSAL    // Stock decreased by disposal approval
  RETURN      // Stock restored from a declined sale
  ADJUSTMENT  // Manual quantity edit by admin

  @@map("stock_movement_type")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  type          StockMovementType
  // Positive = stock added, Negative = stock removed.
  quantityChange Int              @map("quantity_change")
  // The resulting quantity after this movement.
  quantityAfter  Int              @map("quantity_after")
  // Optional description (e.g. "Restocked product", "Added orders").
  description   String?           @db.VarChar(255)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, branchId, createdAt(sort: Desc)])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("stock_movements")
}

// ============================================================================
// SALES
// ============================================================================

enum PaymentMethod {
  Cash
  Gcash
  BankTransfer
  // Generic "paid digitally, unspecified" bucket.
  Cashless
  // Item-level only: paid across more than one of the above (see
  // SaleItem.paymentSplit for the breakdown).
  Split
  // Sale-level only: a rollup shown when a sale's items don't all share the
  // same paymentMethod.
  Mixed

  @@map("payment_method")
}

enum SaleStatus {
  PENDING
  APPROVED
  DECLINED

  @@map("sale_status")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  // Human-friendly reference shown in the UI (e.g. #3) — resets to 1 each
  // day, independently per branch (see DailySaleCounter). Not globally
  // unique: two branches, or the same branch on different days, can and
  // will reuse the same number.
  number        Int           @default(0)
  branchId      String        @map("branch_id") @db.Uuid
  staffId       String        @map("staff_id") @db.Uuid
  customerName  String?       @map("customer_name") @db.VarChar(150)
  // Rollup of the items' paymentMethod: the shared value if every item used
  // the same one, otherwise Mixed. Not the source of truth for totals — see
  // SaleItem.paymentMethod / paymentSplit for that.
  paymentMethod PaymentMethod @default(Cash) @map("payment_method")
  status        SaleStatus    @default(PENDING)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  decidedById   String?       @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?     @map("decided_at") @db.Timestamp(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff     User       @relation("SaleStaff", fields: [staffId], references: [id], onDelete: Restrict)
  decidedBy User?      @relation("SaleDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@index([branchId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("sales")
}

// Backs Sale.number: one row per (branch, day), atomically incremented so
// each branch's sale numbering starts back at 1 every day.
model DailySaleCounter {
  id       String   @id @default(uuid()) @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  date     DateTime @db.Date
  count    Int      @default(0)

  @@unique([branchId, date])
  @@map("daily_sale_counters")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  // Snapshots so historical records survive product edits/deletes.
  name      String  @db.VarChar(150)
  brandName String  @map("brand_name") @db.VarChar(100)
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  // Cost price snapshot at time of sale (for profit calculations, Owner-only).
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(10, 2)
  // Fixed ₱ amount knocked off this line (0 = none). subTotal already
  // reflects it: subTotal = unitPrice * quantity - discount.
  discount  Decimal @default(0) @db.Decimal(10, 2)
  subTotal  Decimal @map("sub_total") @db.Decimal(12, 2)

  // How this specific item was paid for.
  paymentMethod PaymentMethod @default(Cash) @map("payment_method")
  // Which bank, when paymentMethod is BankTransfer (or included in a split).
  bankNote      String?       @map("bank_note") @db.VarChar(100)
  // Free-text reminder/note for this item.
  note          String?       @map("note") @db.VarChar(255)
  // { cash, gcash, bankTransfer, cashless } amounts, only when paymentMethod
  // is Split — must sum to subTotal.
  paymentSplit  Json?         @map("payment_split") @db.JsonB

  // Relations
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// A staff member's in-progress (not-yet-submitted) cart. One row per staff —
// upserted as they add/edit/remove items, cleared on submit or manual clear.
// Lets Admins see what's currently being built, per branch, on the Pending
// Sales page before it becomes actual PENDING Sale/Disposal/Expense records.
model DraftOrder {
  id            String        @id @default(uuid()) @db.Uuid
  staffId       String        @unique @map("staff_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  // Items to sell.
  items         Json          @default("[]") @db.JsonB
  // Items to write off (staged disposals), submitted alongside the sale.
  disposalItems Json          @default("[]") @map("disposal_items") @db.JsonB
  // Staged expense entries ({ amount, note }[]), submitted alongside the sale.
  expenses      Json          @default("[]") @db.JsonB
  customerName  String?       @map("customer_name") @db.VarChar(150)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  staff  User   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("draft_orders")
}

// ============================================================================
// DISPOSALS (damaged / expired / unsellable stock written off)
// ============================================================================

enum DisposalStatus {
  PENDING
  APPROVED
  DECLINED

  @@map("disposal_status")
}

model Disposal {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  // Snapshots so the record survives product edits/deletes.
  productName String   @map("product_name") @db.VarChar(150)
  brandName   String   @map("brand_name") @db.VarChar(100)
  quantity    Int
  // Per-unit price snapshot + total value written off (PHP).
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  value       Decimal  @db.Decimal(12, 2)
  reason      String?  @db.Text
  // Disposals are requested then approved/declined by an Admin. Stock is
  // reserved (deducted) immediately on request, and restored if declined or
  // deleted while still pending.
  status      DisposalStatus @default(PENDING)
  createdById String?  @map("created_by_id") @db.Uuid
  decidedById String?  @map("decided_by_id") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("DisposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy User?    @relation("DisposalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([productId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("disposals")
}

// ============================================================================
// EXPENSES (staff-logged out-of-pocket costs, e.g. utility bills)
// ============================================================================

enum ExpenseStatus {
  PENDING
  APPROVED
  DECLINED

  @@map("expense_status")
}

model Expense {
  id          String        @id @default(uuid()) @db.Uuid
  branchId    String        @map("branch_id") @db.Uuid
  staffId     String        @map("staff_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  note        String        @db.VarChar(255)
  // Expenses are requested then approved/declined by an Admin, same as
  // Sales/Disposals. Approved expenses net against a branch's daily sales
  // total (see StatsService's branch-summary calculation).
  status      ExpenseStatus @default(PENDING)
  decidedById String?       @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?     @map("decided_at") @db.Timestamp(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff     User   @relation("ExpenseStaff", fields: [staffId], references: [id], onDelete: Restrict)
  decidedBy User?  @relation("ExpenseDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("expenses")
}

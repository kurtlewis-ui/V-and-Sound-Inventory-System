# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database (Neon connection string for production)
DATABASE_URL="postgresql://postgres:password@localhost:5432/vape_shop_db?schema=public"

# JWT (generate random 32+ char strings for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32
JWT_REFRESH_EXPIRATION=7d

# CORS (your Vercel frontend URL in production)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Bcrypt
BCRYPT_ROUNDS=12

# Session
SESSION_TIMEOUT=900

# Body size limit (for base64 image uploads)
BODY_LIMIT=15mb
